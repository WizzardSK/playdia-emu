# ─────────────────────────────────────────────────────────────
#  libretro core build
#
#  The core is the emulator without the SDL frontend and without the
#  libavcodec path, so it needs nothing but a C compiler and libm. Zips are
#  read with the vendored miniz, and content the C library cannot open goes
#  through the frontend's VFS.
#
#  make -f Makefile.libretro platform=unix
# ─────────────────────────────────────────────────────────────

TARGET_NAME := playdia

ifeq ($(platform),)
	platform = unix
	ifeq ($(shell uname -s),)
		platform = win
	else ifneq ($(findstring MINGW,$(shell uname -s)),)
		platform = win
	else ifneq ($(findstring Darwin,$(shell uname -s)),)
		platform = osx
	endif
endif

CORE_DIR := .
SOURCES_C := \
	$(CORE_DIR)/src/playdia_libretro.c \
	$(CORE_DIR)/src/cpu_tlcs870.c \
	$(CORE_DIR)/src/cpu_nec78k.c \
	$(CORE_DIR)/src/cdrom.c \
	$(CORE_DIR)/src/ak8000.c \
	$(CORE_DIR)/src/ak8000_pd.c \
	$(CORE_DIR)/src/zip_stream.c \
	$(CORE_DIR)/src/vfs_file.c \
	$(CORE_DIR)/src/miniz/miniz.c \
	$(CORE_DIR)/src/interconnect.c \
	$(CORE_DIR)/src/pipeline.c \
	$(CORE_DIR)/src/bios_hle.c \
	$(CORE_DIR)/src/playdia_sys.c

LIBS := -lm
fpic :=
SHARED :=
LDFLAGS :=

# The core is dlopened next to a frontend that has symbols of its own; without
# this the dynamic linker can bind our calls to the frontend's copies.
LINK_VERSION_SCRIPT := -Wl,--version-script=$(CORE_DIR)/link.T -Wl,-Bsymbolic

# ── Unix ─────────────────────────────────────────────────────
ifneq (,$(findstring unix,$(platform)))
	TARGET := $(TARGET_NAME)_libretro.so
	fpic := -fPIC
	SHARED := -shared $(LINK_VERSION_SCRIPT)
	ifneq (,$(findstring Haiku,$(shell uname -s)))
		LIBS :=
	endif

# ── macOS ────────────────────────────────────────────────────
else ifeq ($(platform), osx)
	TARGET := $(TARGET_NAME)_libretro.dylib
	fpic := -fPIC
	SHARED := -dynamiclib
	ifeq ($(CROSS_COMPILE),1)
		TARGET_RULE = -target $(LIBRETRO_APPLE_PLATFORM) -isysroot $(LIBRETRO_APPLE_ISYSROOT)
		CFLAGS += $(TARGET_RULE)
		LDFLAGS += $(TARGET_RULE)
	endif

# ── iOS / tvOS ───────────────────────────────────────────────
else ifneq (,$(findstring ios,$(platform)))
	TARGET := $(TARGET_NAME)_libretro_ios.dylib
	fpic := -fPIC
	SHARED := -dynamiclib
	MINVERSION := -miphoneos-version-min=11.0
	IOSSDK := $(shell xcodebuild -version -sdk iphoneos Path 2>/dev/null)
	CC := cc -arch arm64 -isysroot $(IOSSDK) $(MINVERSION)
	CFLAGS += -DIOS

# ── Android ──────────────────────────────────────────────────
else ifneq (,$(findstring android,$(platform)))
	TARGET := $(TARGET_NAME)_libretro_android.so
	fpic := -fPIC
	SHARED := -shared $(LINK_VERSION_SCRIPT)
	CC = $(ANDROID_CC)

# ── Emscripten ───────────────────────────────────────────────
else ifeq ($(platform), emscripten)
	TARGET := $(TARGET_NAME)_libretro_emscripten.bc
	STATIC_LINKING = 1

# ── Nintendo Switch (libnx) ──────────────────────────────────
else ifeq ($(platform), libnx)
	include $(DEVKITPRO)/libnx/switch_rules
	TARGET := $(TARGET_NAME)_libretro_$(platform).a
	CFLAGS += -D__SWITCH__ -DHAVE_LIBNX -fPIE
	STATIC_LINKING = 1

# ── Windows (MinGW) ──────────────────────────────────────────
else
	TARGET := $(TARGET_NAME)_libretro.dll
	CC ?= gcc
	SHARED := -shared -static-libgcc -Wl,--no-undefined $(LINK_VERSION_SCRIPT)
endif

ifeq ($(DEBUG), 1)
	CFLAGS += -O0 -g
else
	CFLAGS += -O2 -DNDEBUG
endif

OBJECTS := $(SOURCES_C:.c=.o)
CFLAGS  += -Wall -Wextra -std=c11 $(fpic) -I$(CORE_DIR)/src

all: $(TARGET)

ifeq ($(STATIC_LINKING), 1)
$(TARGET): $(OBJECTS)
	$(AR) rcs $@ $(OBJECTS)
else
$(TARGET): $(OBJECTS)
	$(CC) $(fpic) $(SHARED) $(LDFLAGS) -o $@ $(OBJECTS) $(LIBS)
endif

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJECTS) $(TARGET)

.PHONY: all clean
